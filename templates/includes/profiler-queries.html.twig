<span class="md-profiler-item md-profiler-queries" title="Requêtes SQL - Cliquez pour plus de détails">
  <span class="md-profiler-label">🗃</span>
  <span class="md-profiler-value">{{ queries }} requêtes en {{ queries_time|number_format(2) }}ms</span>
  <div class="md-profiler-queries-details">
    <div class="md-profiler-queries-header">
      <h3>{{ queries }} Requêtes SQL ({{ queries_time|number_format(2) }}ms)</h3>
    </div>
    <div class="md-profiler-queries-list">
      {% for query in queries_list %}
      <div class="md-profiler-query-item">
        <div class="md-profiler-query-time">{{ (query.time * 1000)|number_format(2) }}ms</div>
        <div class="md-profiler-query-sql">{{ query.query }}</div>
        {% if query.args %}
        <div class="md-profiler-query-args">
          <strong>Arguments:</strong> {{ query.args|json_encode(constant('JSON_PRETTY_PRINT')) }}
        </div>
        {% endif %}
        <div class="md-profiler-query-caller">
          <strong>Appelée par:</strong> {{ query.caller.file|default('N/A') }}:{{ query.caller.line|default('N/A') }}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</span>