<div id="monitoring-drupal-profiler" class="md-profiler">
  <div class="md-profiler-bar">
    <span class="md-profiler-item">
      <span class="md-profiler-label">Time:</span>
      <span class="md-profiler-value">{{ (time * 1000)|number_format(2) }}ms</span>
    </span>
    
    <span class="md-profiler-item">
      <span class="md-profiler-label">Memory:</span>
      <span class="md-profiler-value">{{ memory|number_format(2) }}MB</span>
    </span>
    
    <span class="md-profiler-item">
      <span class="md-profiler-label">Queries:</span>
      <span class="md-profiler-value">{{ queries }}</span>
    </span>
    
    <span class="md-profiler-item">
      <span class="md-profiler-label">Cache:</span>
      <span class="md-profiler-value">{{ cache_hits }} hits</span>
    </span>
  </div>
</div>
<style>
.md-profiler {
  position: fixed;
  bottom: 0;
  right: 0;
  background: #333;
  color: white;
  padding: 8px 12px;
  z-index: 10000;
  font-family: monospace;
  font-size: 12px;
  border-top-left-radius: 4px;
  box-shadow: 0 0 10px rgba(0,0,0,0.3);
}

.md-profiler-bar {
  display: flex;
  gap: 20px;
}

.md-profiler-item {
  display: flex;
  gap: 5px;
}

.md-profiler-label {
  color: #ccc;
}

.md-profiler-value {
  color: #fff;
  font-weight: bold;
}

.md-profiler:hover {
  background: #555;
}
</style>