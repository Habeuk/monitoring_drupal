<span class="md-profiler-item md-profiler-request" title="Requête: {{ request_data.method }} {{ request_data.uri }} - Status: {{ response_data.status_text }} - IP: {{ request_data.client_ip }} - Ajax: {{ request_data.is_ajax ? 'Oui' : 'Non' }}">
  <span class="md-profiler-label">🌐</span>
  <span class="md-profiler-value">
    {{ response_data.status_code }}
  </span>
  <div class="md-profiler-details">
  	<ul>
        {% for key, value in response_data %}
            <li>{{ key }}: {{ value }}</li>
        {% endfor %}
    </ul>
    <ul>
        {% for key, value in request_data %}
            <li>{{ key }}: {{ value }}</li>
        {% endfor %}
    </ul>
  </div>
</span>